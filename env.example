# Copy to .env and fill in HF_TOKEN:   cp env.example .env
#
# Speaker diarization and search embeddings use gated models. With your Hugging Face account:
#   1. Create a read token:      https://huggingface.co/settings/tokens
#   2. Accept the model terms:   https://huggingface.co/pyannote/speaker-diarization-community-1
#                                https://huggingface.co/google/embeddinggemma-300m
HF_TOKEN=

# Maximum upload length in seconds (default 10 minutes).
MAX_DURATION_SECONDS=600

# Host ports. The app is reachable from this machine only; APP_BIND=0.0.0.0 shares it on your
# network (it has no login).
APP_BIND=127.0.0.1
APP_PORT=8501
POSTGRES_PORT=5433

# Local-only database credentials.
POSTGRES_USER=audio
POSTGRES_PASSWORD=audio
POSTGRES_DB=audio_search
